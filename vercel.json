{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "buildCommand": "npm install && npx vite build",
  "installCommand": "npm install --legacy-peer-deps",
  "nodeVersion": "20.x",
  "outputDirectory": "dist"
}